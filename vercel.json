{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/api", "destination": "/api/index.py" },
    { "source": "/auth/(.*)", "destination": "/api/index.py" },
    { "source": "/iot/(.*)", "destination": "/api/index.py" },
    { "source": "/dustbins/(.*)", "destination": "/api/index.py" },
    { "source": "/dashboard/(.*)", "destination": "/api/index.py" },
    { "source": "/employees/(.*)", "destination": "/api/index.py" },
    { "source": "/leaderboard/(.*)", "destination": "/api/index.py" },
    { "source": "/complaints/(.*)", "destination": "/api/index.py" },
    { "source": "/collections/(.*)", "destination": "/api/index.py" },
    { "source": "/drivers/(.*)", "destination": "/api/index.py" },
    { "source": "/tasks/(.*)", "destination": "/api/index.py" },
    { "source": "/docs", "destination": "/api/index.py" },
    { "source": "/openapi.json", "destination": "/api/index.py" },
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/assets/(.*)", "destination": "/frontend/assets/$1" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ]
}
