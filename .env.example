# Copy to .env and fill in real values. Never commit .env.

# REQUIRED in production.
# backend/app/routers/auth.py falls back to a hardcoded dev key
# ("smartbin-secret-key-change-in-prod") when this is unset. That fallback is
# public in this repository, so anyone could forge a login token for any role.
# Always set an explicit random value when deploying.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional. Defaults to a local SQLite file at backend/smartbin.db.
# Use PostgreSQL in production, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/smartbin
DATABASE_URL=
